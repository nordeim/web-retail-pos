// ---------------------------------------------------------------------------
// VeloxPOS — Prisma schema (9 models)
//
// DATABASE PATH CONTRACT (pinned by tests/db-path.test.ts — read .env.example):
//   DATABASE_URL="file:../db/custom.db" must resolve to <repo>/db/custom.db
//   for the Prisma CLI (schema-anchored) AND the runtime (src/lib/db-path.ts
//   applies the same rule). The `db:*` package scripts set the env var inline
//   (shell-provided → schema-anchored); never rely on repo-root .env
//   auto-loading with the raw CLI.
//
// MONEY CONTRACT: every monetary amount is an INTEGER amount of cents
// (price, cost, floats, totals — "Precio de venta" 38.50 is stored as 3850).
// Tax rates are integer basis points of percent ×100 (16% → 1600) so the
// math stays exact. Formatting/rounding lives ONLY in src/lib/money.ts.
//
// Relations: every user-owned model carries `userId` with onDelete: Cascade.
// Optional references (category, cashier, register, shift, product) use
// SetNull — history rows (Sale/SaleItem/Shift) survive master-data deletes.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  fullName      String   @default("")
  // S15 auth flows: registration creates an UNVERIFIED account; the 6-digit
  // code rides the register response (self-hosted, no SMTP).
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories         Category[]
  products           Product[]
  cashRegisters      CashRegister[]
  cashiers           Cashier[]
  shifts             Shift[]
  sales              Sale[]
  storeSettings      StoreSettings?
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit OTP
  expiresAt DateTime // 15-minute window
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, code])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // 48-hex one-shot
  expiresAt DateTime // 30-minute window
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String // 1..60, unique per user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id         String    @id @default(cuid())
  userId     String
  categoryId String?
  name       String // 1..120
  barcode    String // unique per user, 1..64
  priceCents Int // sale price ≥ 0
  costCents  Int? // acquisition cost, optional
  stock      Int       @default(0) // ≥ 0
  minStock   Int       @default(5) // low-stock threshold
  taxRate    Int       @default(1600) // basis points of percent (16% → 1600)
  unit       String    @default("Pieza") // Pieza | Kilogramo | Litro | Paquete
  imageUrl   String? // data URL ≤ ~1.5 MB
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems  SaleItem[]

  @@unique([userId, barcode])
  @@index([userId])
  @@index([categoryId])
}

model CashRegister {
  id        String   @id @default(cuid())
  userId    String
  name      String // 1..60, unique per user
  location  String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts    Shift[]
  sales     Sale[]

  @@unique([userId, name])
  @@index([userId])
}

model Cashier {
  id        String   @id @default(cuid())
  userId    String
  name      String // 1..80
  email     String   @default("")
  phone     String   @default("")
  pin       String   @default("") // optional 4-6 digit terminal PIN (hashed at the seam)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts    Shift[]
  sales     Sale[]

  @@index([userId])
}

model Shift {
  id             String       @id @default(cuid())
  userId         String
  registerId     String
  cashierId      String
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  openingFloatCents Int       @default(0) // fondo de caja inicial ≥ 0
  closingAmountCents Int?
  expectedAmountCents Int?    // float + sales at close time
  differenceCents Int?
  status         String       @default("open") // open | closed
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  register       CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashier        Cashier      @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  sales          Sale[]

  @@index([userId])
  @@index([registerId, status])
  @@index([cashierId])
}

model Sale {
  id            String   @id @default(cuid())
  userId        String
  ticketNumber  String   @unique // "V-XXXXXXXX"
  cashierId     String?
  registerId    String?
  shiftId       String?
  customerName  String   @default("")
  paymentMethod String   @default("cash") // cash | card | transfer
  subtotalCents Int
  taxCents      Int
  totalCents    Int
  status        String   @default("completed") // completed | refunded
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashier       Cashier?    @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  register      CashRegister? @relation(fields: [registerId], references: [id], onDelete: SetNull)
  shift         Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items         SaleItem[]

  @@index([userId])
  @@index([shiftId])
  @@index([createdAt])
}

// SaleItem carries NO userId — ownership scopes through its sale (S7 precedent).
model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  name        String // snapshot at sale time
  unitPriceCents Int
  quantity    Int // ≥ 1
  taxRate     Int      @default(1600)
  lineTotalCents Int // unitPrice × qty, tax-exclusive
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model StoreSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  storeName      String   @default("Mi Tienda")
  logoUrl        String? // data URL ≤ ~1.5 MB
  address        String   @default("")
  phone          String   @default("")
  email          String   @default("")
  taxId          String   @default("") // RFC / ID Fiscal
  currency       String   @default("MXN")
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#8b5cf6")
  ticketFooter   String   @default("¡Gracias por su compra! Vuelva pronto.")
  cardProvider   String   @default("none") // none | terminal | link
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

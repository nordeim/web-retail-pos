// ---------------------------------------------------------------------------
// VeloxPOS — Prisma schema (retail POS domain)
//
// DATABASE PATH CONTRACT (pinned by tests/db-path.test.ts — read .env.example):
//   DATABASE_URL="file:../db/custom.db" must resolve to <repo>/db/custom.db
//   for the Prisma CLI (schema-anchored) AND the runtime (src/lib/db-path.ts
//   applies the same rule). The `db:*` package scripts set the env var inline
//   (shell-provided → schema-anchored); never rely on repo-root .env
//   auto-loading with the raw CLI.
//
// Relations: every user-owned model carries `userId` with onDelete: Cascade.
// Optional product references (SaleItem.productId) use SetNull so history
// survives product deletion. Money is stored as integer cents — never floats.
// ---------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String   @default("")
  // The S15 flow: register → verify (the OTP rides the API response — no
  // SMTP in a self-hosted install) → verified. The seed's owner is verified.
  emailVerified Boolean @default(false)
  // V2 M6: bumped on every password reset — the session HMAC carries the
  // version it was minted with and every authed read compares, so a reset
  // instantly revokes every pre-reset cookie.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     StoreSetting?
  categories   Category[]
  products     Product[]
  registers    Register[]
  cashiers     Cashier[]
  shifts       Shift[]
  sales        Sale[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

// ---- auth (kept from the scaffold, unchanged contracts) --------------------

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit OTP
  // V2 H2: atomic wrong-attempt counter — 6 misses kill the token.
  attempts  Int      @default(0)
  expiresAt DateTime // 15-minute window
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // 48-hex one-shot
  expiresAt DateTime // 30-minute window
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- retail domain ----------------------------------------------------------

model StoreSetting {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String  @default("Mi Tienda")
  logoUrl        String?
  address        String  @default("")
  phone          String  @default("")
  email          String  @default("")
  fiscalId       String  @default("") // RFC / ID Fiscal
  currency       String  @default("MXN")
  primaryColor   String  @default("#6366f1")
  secondaryColor String  @default("#8b5cf6")
  ticketFooter   String  @default("")
  cardProvider   String  @default("Ninguno")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id         String   @id @default(cuid())
  userId     String
  name       String
  barcode    String   @default("")
  categoryId String?
  price      Int // cents, IVA-exclusive
  cost       Int      @default(0) // cents
  stock      Int      @default(0)
  minStock   Int      @default(5)
  ivaRate    Int      @default(16) // percent
  unit       String   @default("Pieza")
  imageUrl   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems SaleItem[]

  @@unique([userId, name])
  @@index([userId])
}

model Register {
  id        String   @id @default(cuid())
  userId    String
  name      String
  location  String   @default("")
  status    String   @default("closed") // closed | open
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts Shift[]
  sales  Sale[]

  @@index([userId])
}

model Cashier {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([userId])
}

model Shift {
  id            String    @id @default(cuid())
  userId        String
  registerId    String
  cashierId     String
  openingFloat  Int       @default(0) // cents — fondo de caja inicial
  closingAmount Int? // cents — conteo final
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  status        String    @default("open") // open | closed

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  register Register @relation(fields: [registerId], references: [id], onDelete: Cascade)
  cashier  Cashier  @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  sales    Sale[]

  @@index([userId, registerId, status])
}

model Sale {
  id          String   @id @default(cuid())
  userId      String
  ticketNo    String   @unique // V-XXXXXXXX
  method      String   @default("efectivo") // efectivo | tarjeta
  status      String   @default("completada") // completada | cancelada
  subtotal    Int // cents, IVA-exclusive
  tax         Int // cents
  total       Int // cents
  clientName  String   @default("")
  cashierName String   @default("") // snapshot at sale time
  registerName String  @default("") // snapshot at sale time
  registerId  String?
  shiftId     String?
  createdAt   DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  register Register? @relation(fields: [registerId], references: [id], onDelete: SetNull)
  shift    Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  items    SaleItem[]

  @@index([userId, createdAt])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String?
  name      String // snapshot at sale time
  qty       Int
  unitPrice Int // cents, IVA-exclusive
  ivaRate   Int    @default(16)
  lineTotal Int // cents, IVA-inclusive: round(unitPrice × (1+iva/100) × qty)

  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
}

# VeloxPOS — local development environment
# The path is schema-anchored: file:../db/custom.db resolves to <repo>/db/custom.db
# for the Prisma CLI AND the runtime (src/lib/db-path.ts applies the same rule).
DATABASE_URL="file:../db/custom.db"

# Session/HMAC secret. This example value is a PUBLIC PLACEHOLDER — the
# production boot guard (src/lib/env-check.ts) refuses to start with it.
# Generate a real one for any shared deployment:
#   openssl rand -hex 32
AUTH_SECRET="dev-only-veloxpos-secret-change-me"

# Canonical public origin for metadata/sitemap/robots (src/lib/site.ts).
# Optional in development; set it on any deployed host.
# NEXT_PUBLIC_SITE_URL="https://pos.example.com"

# In-app reset-link delivery (V2 C1): when "1", POST /api/auth/forgot-password
# returns the one-shot reset URL in the response body — the no-SMTP demo
# posture. Non-production defaults to on; a default PRODUCTION boot never
# carries the token (recovery without a mail channel: re-seed the owner or
# run the reset through a trusted admin shell).
# RESET_INAPP_DELIVERY="1"

# Trusted proxy hops in front of this process (V2 H3): the rate limiter's
# client IP is read that many positions from the RIGHT of x-forwarded-for.
# 0 (default) = directly exposed (the rightmost hop is the one your nearest
# proxy appended). Never trust the FIRST hop — it is client-controlled.
# AUTH_PROXY_HOPS="0"

# Seed defaults (used by `bun run db:seed` only — never read by src/).
# NOTE: the seed password default lives IN prisma/seed.ts — bun's dotenv
# expands $… inside .env values, so a password with '$' cannot ride this file.
SEED_OWNER_EMAIL="owner@veloxpos.local"
SEED_OWNER_NAME="Cesar Martínez"
